# --- Modelos de IA (opcional — ver src/config/models.ts) ---
# Descomentar e ajustar para trocar de modelo sem alterar código.
# Se AGENT_MODEL_TEMPERATURE/TOP_P/FREQUENCY_PENALTY/REASONING_EFFORT não forem definidas,
# o parâmetro correspondente simplesmente não é enviado à API (nada de default implícito).
# AGENT_MODEL=gpt-4o
# AGENT_MODEL_TEMPERATURE=0.8
# AGENT_MODEL_TOP_P=0.9
# AGENT_MODEL_FREQUENCY_PENALTY=0.3
# AGENT_MODEL_REASONING_EFFORT=none
# PARSER_CHAIN_MODEL=gpt-4.1-mini
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Timings/limites (opcional — ver src/config/constants.ts) ---
# DEBOUNCE_WINDOW_MS=20000
# SPLIT_MAX_CHARS_PER_MESSAGE=300
