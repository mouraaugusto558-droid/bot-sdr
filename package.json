{
  "name": "nanda-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend TypeScript code-first da Nanda (agente de recepção via WhatsApp/Chatwoot), motor de orquestração LangGraph. Drop-in replacement do workflow n8n original.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/type-provider-zod": "^1.0.0",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.5",
    "@pinecone-database/pinecone": "^8.2.0",
    "bullmq": "^6.0.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.15.0",
    "nock": "^14.0.17",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
